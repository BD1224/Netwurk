# Copy to .env.local and fill in. Never commit .env.local.
# Claude API key: used only on the server (src/lib/anthropic.ts).
ANTHROPIC_API_KEY=
# Supabase project URL + public anon key: safe in the browser because RLS limits each user to their own rows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional GitHub token (no scopes needed): raises the public API limit for the Discover overlay's repo list.
GITHUB_TOKEN=
