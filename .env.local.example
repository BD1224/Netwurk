# Copy to .env.local and fill in. Never commit .env.local.
# Google Gemini API key (aistudio.google.com): used only on the server (src/lib/ai.ts).
# The variable keeps its old name; GEMINI_API_KEY works too. GEMINI_MODEL optionally picks the model.
ANTHROPIC_API_KEY=
# Serper API key: used only on the server
SERPER_API_KEY=
# OpenAlex API key (free, https://openalex.org/settings/api): used only on the server for papers.
# Optional locally, but set it in production: without it, all of Vercel shares one tiny daily budget.
OPENALEX_API_KEY=
# Supabase project URL + public anon key: safe in the browser because RLS limits each user to their own rows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Test user for manual scripts in tests/manual (create in Supabase: Authentication → Users → Add user).
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
# Set to 1 to return 3 fake people instead of calling Claude/Serper (for UI testing, no tokens).
MOCK_SEARCH=
